{
  "name": "brede-welvaart",
  "private": true,
  "version": "0.1.0",
  "description": "Brede Welvaart Scan: collect, review and archive outcomes of Brede Welvaart workshops (City of Amsterdam)",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "scripts": {
    "dev": "turbo run dev --filter=./apps/backend --filter=./apps/frontend --filter=./apps/ai-service",
    "dev:infra": "docker compose up mongodb azurite -d",
    "dev:pdf": "turbo run dev --filter=./apps/pdf-frontend -- --host 0.0.0.0",
    "dev:ai": "turbo run dev --filter=./apps/ai-service",
    "dev:e2e": "turbo run dev --filter=./apps/backend --filter=./apps/frontend --filter=./apps/pdf-frontend --filter=./apps/ai-service",
    "dev:all": "pnpm dev:infra && pnpm dev:e2e",
    "build": "pnpm --filter ./apps/frontend build && pnpm --filter ./apps/pdf-frontend build",
    "lint": "pnpm --filter ./apps/frontend lint && pnpm --filter ./apps/pdf-frontend lint",
    "typecheck": "tsc --build apps/shared/types apps/shared/ui apps/frontend --pretty false && pnpm --filter ./apps/ai-service-mock exec tsc --noEmit --pretty false",
    "test": "pnpm --filter ./apps/frontend test && pnpm --filter ./apps/backend test:ci",
    "check:generated": "pnpm codegen && git diff --exit-code -- apps/shared/types/src/graphql.ts",
    "check:python": "uv --directory apps/ai-service run flake8 main.py src tests conftest.py && uv --directory apps/ai-service run python -m compileall -q main.py src && uv --directory apps/ai-service run pytest -m 'not integration'",
    "audit": "pnpm audit --audit-level high && uv --directory apps/ai-service run pip-audit --local",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:generated && pnpm check:python && pnpm run audit",
    "codegen": "pnpm --filter ./apps/shared/types run codegen",
    "preinstall": "npx only-allow pnpm",
    "prepare": "node -e \"if (process.env.SKIP_SKILLS_INSTALL === '1') process.exit(0); require('node:child_process').execFileSync('skills', ['experimental_install', '-y'], { stdio: 'inherit' })\""
  },
  "license": "EUPL-1.2",
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "skills": "^1.5.22",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:",
    "turbo": "^2.10.9",
    "wait-on": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Amsterdam/brede-welvaart.git"
  }
}
