FOUNDRY_ENDPOINT="https://<your-foundary-name>.cognitiveservices.azure.com/"
FOUNDRY_API_VERSION="2024-12-01-preview"
FOUNDRY_AUTH_MODE="managed_identity"
# Uses DefaultAzureCredential. Local development should use `az login` or `azd auth login`.
# DefaultAzureCredential excludes PowerShell/broker credentials to keep Linux/container logs clean.
# For temporary API-key auth only, set FOUNDRY_AUTH_MODE="api_key" and inject
# FOUNDRY_API_KEY from a secret store.

# Storage. Use AZURE_STORAGE_ACCOUNT_BLOB_ENDPOINT for deployed environments (RBAC via DefaultAzureCredential).
AZURE_STORAGE_ACCOUNT_BLOB_ENDPOINT="https://<your-storage-account-name>.blob.core.windows.net/"

# Local Azurite only. When set and pointing at Azurite, the storage client uses shared-key auth instead of RBAC.
# Put local overrides in .env.local. The AI service loads .env.local after .env.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:11000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:11001/devstoreaccount1;TableEndpoint=http://127.0.0.1:11002/devstoreaccount1;"

# Enable only for local development; do not enable in shared or production environments.
AISERVICE_DEBUG=false

# Validate storage and AI Foundry connectivity during startup. Set false only for offline development.
AISERVICE_STARTUP_CHECKS=true
