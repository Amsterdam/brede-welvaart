  "talking_points": [
    {
      "topic": "Spreiding en piekdruk in de binnenstad",
      "description": "Bezoekersstromen concentreren zich in een handvol straten en pieken in het zomerseizoen. Ruimtelijke spreiding vraagt om afspraken met vervoerders, evenementenbeleid en herinrichting van knooppunten.",
      "themes": [
        "ruimtelijke-samenhang-en-kwaliteit",
        "subjectief-welzijn"
      ],
      "supporting_doc_ids": [
        "openresearch:51001",
        "openresearch:51002",
        "openresearch:51007"
      ]
    },
    {
      "topic": "Banen versus baanzekerheid",
      "description": "De sector levert veel laagdrempelige werkgelegenheid op, maar de gemiddelde baan kent lage doorgroei en hoge tijdelijkheid. Inzet op opleiding en sociale zekerheid is een open beleidsvraag.",
      "themes": [
        "consumptie-en-inkomen",
        "onderwijs-en-opleiding"
      ],
      "supporting_doc_ids": [
        "openresearch:51003",
        "openresearch:51012"
      ]
    },
    {
      "topic": "Belastinginkomsten en gedragssturing",
      "description": "Toeristenbelasting genereert significante inkomsten maar laat het gedrag van bezoekers nauwelijks zien veranderen. Combineren met tijd- of plaatsgebonden tarieven is een mogelijke route.",
      "themes": [
        "economisch-kapitaal"
      ],
      "supporting_doc_ids": [
        "openresearch:51004",
        "openresearch:51011"
      ]
    },
    {
      "topic": "Bewonersparticipatie en vertrouwen",
      "description": "Bewoners in zwaar bezochte buurten voelen zich onvoldoende gehoord. Versterken van wijkgerichte zeggenschap kan vertrouwen in de gemeente herstellen.",
      "themes": [
        "sociaal-kapitaal",
        "subjectief-welzijn"
      ],
      "supporting_doc_ids": [
        "openresearch:51005"
      ]
    },
    {
      "topic": "Cultureel aanbod als afhankelijke variabele",
      "description": "Bezoekers houden cultureel aanbod overeind, maar verschuiven de programmering. Bewoners ervaren minder ruimte voor lokaal en experimenteel aanbod.",
      "themes": [
        "sociaal-kapitaal"
      ],
      "supporting_doc_ids": [
        "openresearch:51006"
      ]
    },
    {
      "topic": "Druk op de woningmarkt door vakantieverhuur",
      "description": "Korte verhuur vermindert het aanbod permanente woningen in concentratiegebieden. Handhaving en woninggerichte alternatieven blijven politiek beladen.",
      "themes": [
        "wonen"
      ],
      "supporting_doc_ids": [
        "openresearch:51009"
      ]
    }
  ]
