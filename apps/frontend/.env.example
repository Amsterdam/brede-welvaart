# Copy to .env.local for local development. Vite only exposes VITE_* to the browser.
VITE_BACKEND_URL=http://localhost:3000

# Entra ID app registration (SPA). Leave empty to use the DEV_USER mock in the backend.
VITE_ENTRAID_CLIENT_ID=
VITE_ENTRAID_AUTHORITY=https://login.microsoftonline.com/<your-tenant>
VITE_ENTRAID_LOGIN_REDIRECT_URI=http://localhost:5173
VITE_ENTRAID_LOGOUT_REDIRECT_URI=http://localhost:5173

# Optional
VITE_APPINSIGHTS_CONNECTION_STRING=
VITE_CONTACT_EMAIL=
